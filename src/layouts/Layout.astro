---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'NovaGrid Energy | B2B Solar Components Supplier',
	description = 'Factory-direct PV modules, hybrid inverters, and battery storage systems for distributors, EPCs, and OEM buyers.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<script is:inline>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('motion-ready');
			}
		</script>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		color: #17211d;
		background: #f8faf7;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	:global(img) {
		display: block;
		max-width: 100%;
	}
</style>
