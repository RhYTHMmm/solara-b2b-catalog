---
import type { Settings } from '../../lib/homeData';

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;
---

<section class="hero">
  <div class="hero-content">
    <p class="eyebrow hero-step" style="--hero-delay: 80ms;">
      {settings.tagline}
    </p>
    <h1 class="hero-step" style="--hero-delay: 180ms;">
      {settings.heroTitle}
    </h1>
    <p class="hero-copy hero-step" style="--hero-delay: 300ms;">
      {settings.heroSubtitle}
    </p>
    <div class="hero-actions hero-step" style="--hero-delay: 420ms;">
      {
        settings.primaryCta && (
          <a class="button primary" href="#contact">
            {settings.primaryCta}
          </a>
        )
      }
      {
        settings.secondaryCta && (
          <a class="button secondary" href="#products">
            {settings.secondaryCta}
          </a>
        )
      }
    </div>
  </div>
</section>
