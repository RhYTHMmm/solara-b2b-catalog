---
import type { Settings } from '../../lib/homeData';

interface Props {
  stats: Settings['heroStats'];
}

const { stats } = Astro.props;
---

{
  stats?.length ? (
    <section class="stats-band reveal-group" aria-label="Company stats">
      {stats.map((stat, index) => (
        <div
          class="stat reveal"
          data-reveal
          style={`--reveal-delay: ${index * 80}ms;`}
        >
          <strong data-countup={stat.value}>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </section>
  ) : null
}
